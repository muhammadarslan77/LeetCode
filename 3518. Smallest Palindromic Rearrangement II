class Solution:
    
    MOD, MAX = 109930813984377167, int(1e4)
    fact = [1] * (MAX + 1)
    for i in range(1, MAX + 1):
        fact[i] = (fact[i - 1] * i) % MOD
    inv = [1] * (MAX) + [pow(fact[MAX], MOD - 2, MOD)]
    for i in range(MAX, 0, -1):
        inv[i - 1] = (inv[i] * i) % MOD

    def perms(self, f):
        ret = self.fact[sum(f)]
        for i in f:
            ret = (ret * self.inv[i]) % self.MOD
        return ret

    def smallestPalindrome(self, s: str, k: int) -> str:
        n = len(s)
        x = s[: n // 2]
        f = [0] * 26
        for i in x:
            f[ord(i) - ord("a")] += 1
        if self.perms(f) < k:
            return ""
        ans = []
        for i in range(n // 2):
            for j in range(26):
                if f[j] != 0:
                    f[j] -= 1
                    c = self.perms(f)
                    if k <= c:
                        ans.append(chr(j + ord("a")))
                        break
                    k -= c
                    f[j] += 1
        mid = s[n // 2] if n % 2 else ""
        return "".join(ans) + mid + "".join(ans[::-1])
        
