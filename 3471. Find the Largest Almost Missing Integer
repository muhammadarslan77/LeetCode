class Solution:
    def largestInteger(self, nums: List[int], k: int) -> int:
        if k == len(nums):
            return max(nums)
        if k==1:
            c = Counter(nums)
            unique = [k for k,v in c.items() if v==1]
            if len(unique)==0:
                return -1
            else:
                return max(unique)
        c1 = nums.count(nums[0])
        c2 = nums.count(nums[-1])
        if c1 == 1 and c2==1:
            return max(nums[0], nums[-1])
        if c1==1:
            return nums[0]
        if c2==1:
            return nums[-1]
        return -1
